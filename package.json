{
  "name": "interactive-alice",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium-desktop",
    "test:e2e:full": "playwright test",
    "types:schema": "node build/generate-types.mjs && biome check --write src/types/schema.ts",
    "plan:fixture": "node build/python.mjs scripts/show-scene.py --all --plan --json > tests/fixtures/plans.json",
    "check:text": "node build/python.mjs scripts/check-text.py",
    "check:experience": "node build/python.mjs scripts/check-experience.py",
    "check:frontend": "node build/python.mjs scripts/check-frontend.py",
    "check:data": "npm run check:text && npm run check:experience && npm run check:frontend",
    "scene": "node build/python.mjs scripts/show-scene.py",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.2",
    "@types/three": "^0.186.0",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "three": "^0.186.0"
  }
}
