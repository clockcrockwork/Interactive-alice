{
  "name": "interactive-alice",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium-desktop",
    "plan:fixture": "python3 scripts/show-scene.py rabbit-hole --plan --json > tests/fixtures/rabbit-hole.plan.json",
    "types:schema": "node build/generate-types.mjs && biome check --write src/types/schema.ts",
    "test:e2e:full": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.2",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
