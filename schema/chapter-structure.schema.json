{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clockcrockwork/Interactive-alice/schema/chapter-structure.schema.json",
  "title": "Chapter structure file",
  "description": "Language-neutral narrative skeleton for one chapter: scene order, segment order, and who is speaking. Carries no visible text, so scene logic can be built against it without depending on a language.",
  "type": "object",
  "required": ["chapter", "sourceFile", "scenes", "segments"],
  "additionalProperties": false,
  "properties": {
    "chapter": { "type": "integer", "minimum": 1, "maximum": 12 },
    "sourceFile": { "type": "string", "description": "Path to the original public-domain chapter this was adapted from." },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": { "id": { "type": "string", "pattern": "^[a-z0-9-]+$" } }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "scene", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^ch[0-9]{2}\\.s[0-9]{4}$" },
          "scene": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "kind": { "enum": ["narration", "dialogue", "thought", "sound"] },
          "speaker": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        }
      }
    }
  }
}
