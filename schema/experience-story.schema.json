{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clockcrockwork/Interactive-alice/schema/experience-story.schema.json",
  "title": "Experience story file",
  "description": "The runtime Scene order for the whole story. Holds no visible text.",
  "type": "object",
  "required": [
    "story",
    "scenes"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional editor hint; not part of the data."
    },
    "story": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "description": "Scenes in story order.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "file"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "file": {
            "type": "string",
            "description": "Repository-relative path to the scene file."
          }
        }
      }
    }
  }
}
