{
  "$schema": "../schema/locales.schema.json",
  "sourceLocale": "en",
  "baseLocale": "en-simple",
  "locales": {
    "en-simple": {
      "name": "English (simple)",
      "nativeName": "English (simple)",
      "role": "base",
      "maxChars": 90,
      "status": "in-progress",
      "dir": "ltr",
      "lineBreak": "auto",
      "significantSpaces": false,
      "setApart": ["quotes", "capitals"],
      "wordUnit": "spaces",
      "emphasis": "italic",
      "glyphWidth": "half",
      "numbers": "en-GB",
      "notes": "Child-friendly retelling written from the public-domain 1865 text. Every other locale is translated from this, not from the original."
    },
    "ja": {
      "name": "Japanese",
      "nativeName": "日本語",
      "role": "translation",
      "maxChars": 44,
      "status": "in-progress",
      "dir": "ltr",
      "lineBreak": "strict",
      "significantSpaces": true,
      "setApart": ["quotes"],
      "wordUnit": "spaces",
      "emphasis": "slip",
      "glyphWidth": "full",
      "numbers": "ja-JP",
      "notes": "Lower-primary reading level: mostly kana, simple kanji only, and spaces between phrases to help a new reader chunk the line. Those spaces are content."
    }
  }
}
